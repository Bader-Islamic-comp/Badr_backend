  "stories": [
    {
      "id": "story-adam",
      "title": "آدم عليه السلام: التعلّم والتوبة",
      "review_status": "draft",
      "scenes": [
        {
          "id": "adam-01",
          "text": "خلق الله آدم عليه السلام وعلّمه الأسماء كلها. أظهر الله بذلك فضل العلم الذي منحه له.",
          "lesson": "أتعلم كل يوم شيئًا نافعًا.",
          "refs": [
            "quran:2:30-33"
          ],
          "review_status": "draft",
          "needs_check": true,
          "change_note": "«أسماء أشياء كثيرة» صارت «الأسماء كلها» كما في البقرة 31."
        },
        {
          "id": "adam-02",
          "text": "أمر الله الملائكة بالسجود لآدم، فسجدوا طاعة لله، أما إبليس فامتنع وتكبر.",
          "lesson": "أتجنب التكبر وأستمع للحق.",
          "refs": [
            "quran:2:34",
            "quran:7:11-13"
          ],
          "review_status": "draft"
        },
        {
          "id": "adam-03",
          "text": "عاش آدم وزوجه في الجنة، ونهاهما الله عن شجرة. وقعا في الخطأ، ثم أدركا حاجتهما إلى رحمة الله.",
          "lesson": "أعترف بخطئي عندما أخطئ.",
          "refs": [
            "quran:7:19-23"
          ],
          "review_status": "draft"
        },
        {
          "id": "adam-04",
          "text": "علّم الله آدم كلمات يتوب بها إليه، فتقبّل توبته، وجعل للناس هدى يتبعونه.",
          "lesson": "أطلب المغفرة وأصلح ما أستطيع.",
          "refs": [
            "quran:2:37-38",
            "quran:20:122-123"
          ],
          "review_status": "draft"
        }
      ],
      "author": "badr-content-draft"
    },
    {
      "id": "story-musa",
      "title": "موسى عليه السلام: شجاعة وتوكل",
      "review_status": "draft",
      "scenes": [
        {
          "id": "musa-01",
          "text": "أوحى الله إلى أم موسى عليه السلام أن تضعه في اليم حين خافت عليه، ووعدها أن يعيده إليها. فعاد إليها بإذن الله.",
          "lesson": "أثق بالله وأطلب مساعدة أهلي عند الخوف.",
          "refs": [
            "quran:28:7-13"
          ],
          "review_status": "draft"
        },
        {
          "id": "musa-02",
          "text": "ساعد موسى امرأتين عند الماء، ثم دعا الله بالخير وهو في حاجة إليه.",
          "lesson": "أساعد من يحتاج إلى عون.",
          "refs": [
            "quran:28:23-24"
          ],
          "review_status": "draft"
        },
        {
          "id": "musa-03",
          "text": "كلّم الله موسى وأرسله إلى فرعون. طلب موسى من الله أن يشرح صدره، وأن يعينه أخوه هارون.",
          "lesson": "أطلب المساعدة عندما أواجه مهمة كبيرة.",
          "refs": [
            "quran:20:9-36"
          ],
          "review_status": "draft"
        },
        {
          "id": "musa-04",
          "text": "كلّم موسى عليه السلام فرعون ودعاه إلى الحق. أمره الله أن يخاطبه هو وأخوه هارون بكلام لين، مع أن المهمة كانت صعبة.",
          "lesson": "أختار الكلام الهادئ حين أشرح الحق.",
          "refs": [
            "quran:20:42-48"
          ],
          "review_status": "draft"
        },
        {
          "id": "musa-05",
          "text": "قاد موسى قومه بعيدًا عن ظلم فرعون. جعل الله لهم طريقًا في البحر ونجّاهم.",
          "lesson": "أذكر الله وأحافظ على الأمل وقت الشدة.",
          "refs": [
            "quran:26:60-68"
          ],
          "review_status": "draft"
        }
      ],
      "author": "badr-content-draft"
    },
    {
      "id": "story-isa",
      "title": "عيسى عليه السلام: رحمة وآيات بإذن الله",
      "review_status": "draft",
      "author": "badr-content-draft",
      "scenes": [
        {
          "id": "isa-01",
          "text": "بشّر الله مريم عليها السلام بولد اسمه عيسى. تعجبت مريم، فأخبرها المَلَك أن هذا الأمر يسير على الله.",
          "lesson": "أتذكر قدرة الله وأثق به.",
          "refs": [
            "quran:19:16-21",
            "quran:3:45-47"
          ],
          "review_status": "draft",
          "needs_check": true,
          "change_note": "«الرسول» صارت «المَلَك»: «الملائكة» في آل عمران 45، و«رسول ربك» في مريم 19 هو المَلَك."
        },
        {
          "id": "isa-02",
          "text": "حين جاءت مريم بعيسى عليه السلام إلى قومها، أشارَت إليه. تكلّم عيسى وهو طفل، وبيّن أنه عبد الله ونبيّه.",
          "lesson": "أقول الحق بوضوح واحترام.",
          "refs": [
            "quran:19:27-33"
          ],
          "review_status": "draft"
        },
        {
          "id": "isa-03",
          "text": "أرسل الله عيسى إلى بني إسرائيل، وأيّده بآيات عظيمة. كان يذكّرهم أن ما يظهر على يديه يحدث بإذن الله.",
          "lesson": "أنسب الفضل إلى الله وأشكره.",
          "refs": [
            "quran:3:49-51"
          ],
          "review_status": "draft"
        },
        {
          "id": "isa-04",
          "text": "سأل عيسى عليه السلام من يعينه في الدعوة إلى الله، فاستجاب له الحواريون وقالوا إنهم أنصار الله.",
          "lesson": "أتعاون مع الآخرين على عمل الخير.",
          "refs": [
            "quran:3:52-53",
            "quran:61:14"
          ],
          "review_status": "draft"
        }
      ]
    },
    {
      "id": "story-muhammad",
      "title": "محمد ﷺ: الوحي والرحمة والتعليم",
      "review_status": "draft",
      "author": "badr-content-draft",
      "scenes": [
        {
          "id": "muhammad-01",
          "text": "بدأ الوحي إلى النبي محمد ﷺ في غار حراء. كانت أول الآيات التي تلقاها تدعوه إلى القراءة باسم الله، ثم عاد إلى خديجة رضي الله عنها فأعانته وطمأنته.",
          "lesson": "أطلب العون من أهلي حين يواجهني أمر جديد.",
          "refs": [
            "quran:96:1-5",
            "hadith:bukhari:3"
          ],
          "evidence_url": "https://dorar.net/hadith/sharh/6299",
          "grading": "صحيح البخاري 3",
          "review_status": "draft"
        },
        {
          "id": "muhammad-02",
          "text": "كان النبي محمد ﷺ لينًا في تعامله مع أصحابه. علّمهم الله أن اللطف والعفو والمشاورة تعين على اجتماع القلوب.",
          "lesson": "أتحدث بلطف وأستمع إلى غيري.",
          "refs": [
            "quran:3:159"
          ],
          "review_status": "draft"
        },
        {
          "id": "muhammad-03",
          "text": "حين خرج النبي ﷺ مهاجرًا، كان معه صاحب في الغار. ذكّره أن الله معهما، فأنزل الله سكينته عليه.",
          "lesson": "أطمئن من أحب بكلام صادق عند الخوف.",
          "refs": [
            "quran:9:40"
          ],
          "review_status": "draft"
        },
        {
          "id": "muhammad-04",
          "text": "علّم النبي ﷺ طفلًا من آداب الطعام أن يسمّي الله ويأكل بيمينه ومما يليه. علّمه بكلمات قليلة وواضحة.",
          "lesson": "أتعلم آداب الطعام وأعامل الصغار بلطف.",
          "refs": [
            "hadith:bukhari:5376"
          ],
          "evidence_url": "https://dorar.net/hadith/sharh/14362",
          "grading": "صحيح البخاري",
          "review_status": "draft"
        }
      ]
    }
