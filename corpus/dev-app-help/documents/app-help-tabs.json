    {
      "id": "u1",
      "text": "The app has four tabs: Talk, Learn, Quests and Style. Tap a tab to open it.",
      "reference": "tabs 1",
      "section": null,
      "keepWithNext": false
    },
    {
      "id": "u2",
      "text": "The Talk tab shows Robert and the last thing he said to you.",
      "reference": "tabs 2",
      "section": "Talk",
      "keepWithNext": false
    },
    {
      "id": "u3",
      "text": "The Learn tab is where you find your lessons.",
      "reference": "tabs 3",
      "section": "Learn",
      "keepWithNext": false
    },
    {
      "id": "u4",
      "text": "The Quests tab shows today's challenge and whether you have finished it.",
      "reference": "tabs 4",
      "section": "Quests",
      "keepWithNext": false
    },
    {
      "id": "u5",
      "text": "The Style tab is where you choose looks for Robert with your learning stars.",
      "reference": "tabs 5",
      "section": "Style",
      "keepWithNext": false
    }
  ]
