    {
      "id": "u1",
      "text": "On the Talk tab you can ask Robert about using the app, like how to earn stars or how to change his look.",
      "reference": "talk 1",
      "section": null,
      "keepWithNext": false
    },
    {
      "id": "u2",
      "text": "Robert answers one question at a time. He does not remember your earlier questions, so ask your whole question each time.",
      "reference": "talk 2",
      "section": null,
      "keepWithNext": false
    },
    {
      "id": "u3",
      "text": "Robert keeps his answers short and simple. If an answer is not clear, try asking in a different way or ask a trusted adult.",
      "reference": "talk 3",
      "section": null,
      "keepWithNext": false
    }
  ]
