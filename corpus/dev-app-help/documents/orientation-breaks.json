  "units": [
    {
      "id": "u1",
      "text": "Learning works best when you feel rested. It is always fine to take a break.",
      "reference": "breaks 1",
      "section": null,
      "keepWithNext": false
    },
    {
      "id": "u2",
      "text": "In a lesson, you can pause whenever you need and come back later.",
      "reference": "breaks 2",
      "section": null,
      "keepWithNext": false
    },
    {
      "id": "u3",
      "text": "On a break you could stretch, drink some water or rest your eyes by looking at something far away.",
      "reference": "breaks 3",
      "section": null,
      "keepWithNext": false
    },
    {
      "id": "u4",
      "text": "There is no rush. Take the time you need.",
      "reference": "breaks 4",
      "section": null,
      "keepWithNext": false
    }
  ]
