# Explicit local adult-operated synthetic demo only. No automatic .env loading.
COMPANION_DEMO_MODE=false
# Generate a new operator secret with secrets.token_urlsafe(32); no default.
COMPANION_DEMO_TOKEN=

# Grounded answers (doc/rag-system.md section 9). Off unless explicitly true.
COMPANION_RAG_ENABLED=false
# One verified release directory built by `python -m companion_api.rag.pipeline`.
COMPANION_RAG_RELEASE=
# Model endpoints must be on this machine or a private network (localhost or a
# private IP address); the server refuses any other host. Never a hosted provider.
COMPANION_LLM_BASE_URL=http://127.0.0.1:11434/v1
# Allowlisted: qwen3.5:9b, qwen3.5:9b-<tag>, Qwen/Qwen3.5-9B.
COMPANION_LLM_MODEL=qwen3.5:9b
COMPANION_LLM_TIMEOUT_SECONDS=60
# Empty uses COMPANION_LLM_BASE_URL. Must match the embedder the release was built with;
# `hashing` selects the offline development embedder.
COMPANION_EMBEDDING_BASE_URL=
COMPANION_EMBEDDING_MODEL=qwen3-embedding:0.6b
