# Explicit local adult-operated synthetic demo only. No automatic .env loading.
COMPANION_DEMO_MODE=false
# Generate a new operator secret with secrets.token_urlsafe(32); no default.
COMPANION_DEMO_TOKEN=

# Grounded answers (doc/rag-system.md section 9). Off unless explicitly true.
COMPANION_RAG_ENABLED=false
# One verified release directory built by `python -m companion_api.rag.pipeline`.
COMPANION_RAG_RELEASE=
# Model endpoints must be on this machine or a private network (localhost or a
# private IP address); the server refuses any other host. Never a hosted provider.
COMPANION_LLM_BASE_URL=http://127.0.0.1:11434/v1
# Allowlisted: qwen3.5:9b, qwen3.5:9b-<tag>, Qwen/Qwen3.5-9B.
COMPANION_LLM_MODEL=qwen3.5:9b
COMPANION_LLM_TIMEOUT_SECONDS=60
# Empty uses COMPANION_LLM_BASE_URL. Must match the embedder the release was built with;
# `hashing` selects the offline development embedder.
COMPANION_EMBEDDING_BASE_URL=
COMPANION_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Corpus pipeline (doc/SETUP.md). Optional and not read by any script yet: sunnah.com needs a key
# before Riyad as-Salihin and al-Adab al-Mufrad can be cross-checked against a second source.
# SUNNAH_API_KEY=

# The second faith judge (faith-judge-v2, doc/rag-system.md 20): another model family that must also pass every
# answer over religious text. Empty means one judge. Allowlisted: gemma3:4b.
# COMPANION_JUDGE_MODEL=gemma3:4b

# Corpus preview, adult operators only (doc/rag-system.md 9.1): serve the Arabic draft corpus to the
# development app, which then labels every reply as unreviewed. Never a child-facing setting.
# COMPANION_RAG_LANGUAGE=ar
# COMPANION_RAG_PREVIEW_DRAFTS=true

# Speech preview, adult operators only (doc/adr-0006-speech-preview-development.md). Off unless exactly true.
# The release gate's voice switch stays false; this never turns push-to-talk on for a child.
COMPANION_SPEECH_ENABLED=false
# The team's speech service (Dua-a_stt, `bash scripts/run_service.sh`): localhost or a private IP address only.
COMPANION_SPEECH_URL=http://127.0.0.1:8100
# The speech service's DUA_SPEECH_TOKEN; no default.
COMPANION_SPEECH_TOKEN=
# Per-feature kill switches, each on while the preview is on unless set to false.
# COMPANION_SPEECH_RECITATION=false
# COMPANION_SPEECH_VOICE_QUESTIONS=false
# Robert's voice also needs COMPANION_RAG_ENABLED=true: the answer model adds the tashkeel.
# COMPANION_SPEECH_ROBERT_VOICE=false
# COMPANION_ROBERT_VOICE_ID=momen-dev
# COMPANION_SPEECH_TIMEOUT_SECONDS=30
# COMPANION_SPEECH_TTS_TIMEOUT_SECONDS=240
