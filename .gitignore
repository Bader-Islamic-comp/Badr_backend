.venv/
__pycache__/
.pytest_cache/
*.egg-info/
.env
.env.*
!.env.example
*.local.json
dist/
build/

# Corpus releases are build output; rebuild them with the pipeline CLI.
releases/

# Corpus source data: downloaded files and the canonical text built from them are
# regenerated by scripts/fetch_sources.py (sha256-pinned in corpus/sources/registry.yaml).
# Third-party text stays out of git until rights clearance (every licence is pending_legal).
corpus/raw/
corpus/canonical/**/*.jsonl
corpus/layer0/
corpus/wave1/
reports/retrieval/cache/
# Contains Quran and hadith text copied from corpus/canonical; regenerate with scripts/build_decision_packages.py
doc/decisions/04-content-review.md
# Knowledge graph build output (test/corpus-tasks); rebuild with scripts/build_graph.py
corpus/graph/
